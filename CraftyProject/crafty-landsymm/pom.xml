<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>de.cesr</groupId>
		<artifactId>CraftyProject</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>crafty-landsymm</artifactId>
	<packaging>jar</packaging>
	<name>crafty-landsymm</name>
	<description>CRAFTY-PLUM global coupler: CRAFTY's land use with PLUM's markets, through yearly exchange files.</description>

	<properties>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<dependencies>
		<!-- The coupler is written against crafty-core only. crafty-core's other
		     libraries (log4j, tablesaw, ...) come through with it. -->
		<dependency>
			<groupId>de.cesr</groupId>
			<artifactId>crafty-core</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>
		<!-- crafty-react at runtime only: with reactive_afts: true, core loads react's
		     yearly step by class name, so react has to be in the jar, but the coupler's
		     code doesn't use it. React's own fat jar has its own finalName, so this is
		     its plain jar and nothing is duplicated. -->
		<dependency>
			<groupId>de.cesr</groupId>
			<artifactId>crafty-react</artifactId>
			<version>0.0.1-SNAPSHOT</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Test dependencies are not transitive, so this matches crafty-core's. -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.11.0</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.3.0</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
							</filters>

							<finalName>crafty-landsymm-1.0</finalName>
							<transformers>
								<!-- CRAFTY in a coupled run. 48e makes the launcher the main class
								     and starts CRAFTY with -cp ... de.cesr.crafty.landsymm.MainLandSymm. -->
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>de.cesr.crafty.landsymm.MainLandSymm</mainClass>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
			</plugin>
		</plugins>
	</build>
</project>
